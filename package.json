{
  "name": "dogfight",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": ["client", "server"],
  "scripts": {
    "dev:client": "npm --workspace=client run dev",
    "dev:server": "npm --workspace=server run dev",
    "build": "npm --workspace=client run build",
    "start": "npm --workspace=server run start",
    "test": "npm --workspace=server run test",
    "lint": "eslint client/src server/src server/test",
    "format": "prettier --write client/src client/index.html server/src server/test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.6"
  }
}